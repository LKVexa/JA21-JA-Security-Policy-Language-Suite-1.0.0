ja source 0.3
module corpus.ja_security.example_07318
use Security
policy no_network

principal WorkerJASEC_07318
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport45 classification restricted
policy PolicyJASEC_07318 {
    deny network.* by default
    allow ModelExport45 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_07318.decision.mcrt"