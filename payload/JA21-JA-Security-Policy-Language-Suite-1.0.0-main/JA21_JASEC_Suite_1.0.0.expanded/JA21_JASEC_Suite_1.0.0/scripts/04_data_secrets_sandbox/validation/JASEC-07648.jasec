ja source 0.3
module corpus.ja_security.example_07648
use Security
policy no_network

principal WorkerJASEC_07648
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport84 classification restricted
policy PolicyJASEC_07648 {
    deny network.* by default
    deny ModelExport84 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_07648.decision.mcrt"