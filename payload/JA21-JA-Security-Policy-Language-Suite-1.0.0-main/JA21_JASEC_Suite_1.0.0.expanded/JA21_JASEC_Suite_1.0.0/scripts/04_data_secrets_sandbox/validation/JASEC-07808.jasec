ja source 0.3
module corpus.ja_security.example_07808
use Security
policy no_network

principal WorkerJASEC_07808
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport50 classification restricted
policy PolicyJASEC_07808 {
    deny network.* by default
    allow ModelExport50 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_07808.decision.mcrt"