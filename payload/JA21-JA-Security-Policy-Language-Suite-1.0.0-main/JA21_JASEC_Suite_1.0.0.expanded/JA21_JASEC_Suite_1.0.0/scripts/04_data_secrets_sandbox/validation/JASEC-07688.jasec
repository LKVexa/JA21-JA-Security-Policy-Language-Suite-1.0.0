ja source 0.3
module corpus.ja_security.example_07688
use Security
policy no_network

principal WorkerJASEC_07688
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport27 classification restricted
policy PolicyJASEC_07688 {
    deny network.* by default
    allow ModelExport27 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_07688.decision.mcrt"