ja source 0.3
module corpus.ja_security.example_08379
use Security
policy no_network

principal WorkerJASEC_08379
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport39 classification restricted
policy PolicyJASEC_08379 {
    deny network.* by default
    deny ModelExport39 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_08379.decision.mcrt"