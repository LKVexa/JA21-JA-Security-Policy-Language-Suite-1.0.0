ja source 0.3
module corpus.ja_security.example_08699
use Security
policy no_network

principal WorkerJASEC_08699
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport68 classification restricted
policy PolicyJASEC_08699 {
    deny network.* by default
    deny ModelExport68 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_08699.decision.mcrt"