ja source 0.3
module corpus.ja_security.example_08739
use Security
policy no_network

principal WorkerJASEC_08739
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport11 classification restricted
policy PolicyJASEC_08739 {
    deny network.* by default
    allow ModelExport11 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_08739.decision.mcrt"