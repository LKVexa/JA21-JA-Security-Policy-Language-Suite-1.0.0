ja source 0.3
module corpus.ja_security.example_04655
use Security
policy no_network

principal WorkerJASEC_04655
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport98 classification restricted
policy PolicyJASEC_04655 {
    deny network.* by default
    deny ModelExport98 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04655.decision.mcrt"