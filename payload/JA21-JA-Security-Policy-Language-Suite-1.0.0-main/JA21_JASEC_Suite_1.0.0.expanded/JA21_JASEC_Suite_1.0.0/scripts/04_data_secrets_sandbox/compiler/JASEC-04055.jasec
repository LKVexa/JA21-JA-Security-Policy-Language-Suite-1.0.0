ja source 0.3
module corpus.ja_security.example_04055
use Security
policy no_network

principal WorkerJASEC_04055
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport80 classification restricted
policy PolicyJASEC_04055 {
    deny network.* by default
    allow ModelExport80 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04055.decision.mcrt"