ja source 0.3
module corpus.ja_security.example_04175
use Security
policy no_network

principal WorkerJASEC_04175
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport6 classification restricted
policy PolicyJASEC_04175 {
    deny network.* by default
    deny ModelExport6 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04175.decision.mcrt"