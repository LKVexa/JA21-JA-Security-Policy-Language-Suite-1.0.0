ja source 0.3
module corpus.ja_security.example_04015
use Security
policy no_network

principal WorkerJASEC_04015
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport40 classification restricted
policy PolicyJASEC_04015 {
    deny network.* by default
    deny ModelExport40 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04015.decision.mcrt"