ja source 0.3
module corpus.ja_security.example_05056
use Security
policy no_network

principal WorkerJASEC_05056
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport14 classification restricted
policy PolicyJASEC_05056 {
    deny network.* by default
    allow ModelExport14 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05056.decision.mcrt"