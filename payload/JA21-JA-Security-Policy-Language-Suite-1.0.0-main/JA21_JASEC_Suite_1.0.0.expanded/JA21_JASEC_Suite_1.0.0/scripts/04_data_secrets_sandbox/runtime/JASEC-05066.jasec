ja source 0.3
module corpus.ja_security.example_05066
use Security
policy no_network

principal WorkerJASEC_05066
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport24 classification restricted
policy PolicyJASEC_05066 {
    deny network.* by default
    deny ModelExport24 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05066.decision.mcrt"