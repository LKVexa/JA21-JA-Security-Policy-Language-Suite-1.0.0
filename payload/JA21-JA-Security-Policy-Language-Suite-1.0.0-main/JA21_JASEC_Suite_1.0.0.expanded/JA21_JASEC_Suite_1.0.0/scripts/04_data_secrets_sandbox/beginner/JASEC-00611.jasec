ja source 0.3
module corpus.ja_security.example_00611
use Security
policy no_network

principal WorkerJASEC_00611
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport31 classification restricted
policy PolicyJASEC_00611 {
    deny network.* by default
    deny ModelExport31 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_00611.decision.mcrt"