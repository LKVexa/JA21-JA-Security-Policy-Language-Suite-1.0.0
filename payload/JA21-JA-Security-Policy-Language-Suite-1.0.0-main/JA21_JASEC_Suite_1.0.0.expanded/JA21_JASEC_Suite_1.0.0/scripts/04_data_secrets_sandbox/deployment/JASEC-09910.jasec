ja source 0.3
module corpus.ja_security.example_09910
use Security
policy no_network

principal WorkerJASEC_09910
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport18 classification restricted
policy PolicyJASEC_09910 {
    deny network.* by default
    deny ModelExport18 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09910.decision.mcrt"