ja source 0.3
module corpus.ja_security.example_09590
use Security
policy no_network

principal WorkerJASEC_09590
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport86 classification restricted
policy PolicyJASEC_09590 {
    deny network.* by default
    deny ModelExport86 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09590.decision.mcrt"