ja source 0.3
module corpus.ja_security.example_03764
use Security
policy no_network

principal WorkerJASEC_03764
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport80 classification restricted
policy PolicyJASEC_03764 {
    deny network.* by default
    allow ModelExport80 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_03764.decision.mcrt"