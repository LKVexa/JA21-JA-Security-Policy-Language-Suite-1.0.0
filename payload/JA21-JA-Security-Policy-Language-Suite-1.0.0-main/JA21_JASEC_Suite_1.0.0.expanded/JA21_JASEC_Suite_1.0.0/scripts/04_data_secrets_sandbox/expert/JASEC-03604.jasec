ja source 0.3
module corpus.ja_security.example_03604
use Security
policy no_network

principal WorkerJASEC_03604
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport17 classification restricted
policy PolicyJASEC_03604 {
    deny network.* by default
    deny ModelExport17 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03604.decision.mcrt"