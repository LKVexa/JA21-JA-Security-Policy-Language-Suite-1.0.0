ja source 0.3
module corpus.ja_security.example_03524
use Security
policy no_network

principal WorkerJASEC_03524
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport34 classification restricted
policy PolicyJASEC_03524 {
    deny network.* by default
    allow ModelExport34 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_03524.decision.mcrt"