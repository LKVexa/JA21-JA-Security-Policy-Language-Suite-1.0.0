ja source 0.3
module corpus.ja_security.example_03754
use Security
policy no_network

principal WorkerJASEC_03754
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport70 classification restricted
policy PolicyJASEC_03754 {
    deny network.* by default
    allow ModelExport70 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_03754.decision.mcrt"