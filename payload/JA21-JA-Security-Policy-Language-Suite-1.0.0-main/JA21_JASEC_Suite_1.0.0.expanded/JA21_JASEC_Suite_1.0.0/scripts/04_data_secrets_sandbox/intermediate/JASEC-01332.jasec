ja source 0.3
module corpus.ja_security.example_01332
use Security
policy no_network

principal WorkerJASEC_01332
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport73 classification restricted
policy PolicyJASEC_01332 {
    deny network.* by default
    allow ModelExport73 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01332.decision.mcrt"