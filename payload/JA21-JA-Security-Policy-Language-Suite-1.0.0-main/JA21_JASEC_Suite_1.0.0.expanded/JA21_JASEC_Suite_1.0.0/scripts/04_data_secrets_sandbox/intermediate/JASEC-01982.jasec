ja source 0.3
module corpus.ja_security.example_01982
use Security
policy no_network

principal WorkerJASEC_01982
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport44 classification restricted
policy PolicyJASEC_01982 {
    deny network.* by default
    deny ModelExport44 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01982.decision.mcrt"