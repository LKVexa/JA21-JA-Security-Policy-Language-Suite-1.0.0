ja source 0.3
module corpus.ja_security.example_01492
use Security
policy no_network

principal WorkerJASEC_01492
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport39 classification restricted
policy PolicyJASEC_01492 {
    deny network.* by default
    allow ModelExport39 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01492.decision.mcrt"