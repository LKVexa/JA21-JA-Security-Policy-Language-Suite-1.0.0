ja source 0.3
module corpus.ja_security.example_01382
use Security
policy no_network

principal WorkerJASEC_01382
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport26 classification restricted
policy PolicyJASEC_01382 {
    deny network.* by default
    allow ModelExport26 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01382.decision.mcrt"