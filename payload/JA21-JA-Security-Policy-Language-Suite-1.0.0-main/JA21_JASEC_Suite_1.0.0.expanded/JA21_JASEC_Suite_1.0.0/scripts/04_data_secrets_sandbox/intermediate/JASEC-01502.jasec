ja source 0.3
module corpus.ja_security.example_01502
use Security
policy no_network

principal WorkerJASEC_01502
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport49 classification restricted
policy PolicyJASEC_01502 {
    deny network.* by default
    allow ModelExport49 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01502.decision.mcrt"