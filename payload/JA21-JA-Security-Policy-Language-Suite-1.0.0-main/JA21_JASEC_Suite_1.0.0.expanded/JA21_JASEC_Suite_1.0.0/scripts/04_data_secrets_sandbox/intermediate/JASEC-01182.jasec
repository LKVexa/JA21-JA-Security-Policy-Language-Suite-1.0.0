ja source 0.3
module corpus.ja_security.example_01182
use Security
policy no_network

principal WorkerJASEC_01182
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport20 classification restricted
policy PolicyJASEC_01182 {
    deny network.* by default
    deny ModelExport20 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01182.decision.mcrt"