ja source 0.3
module corpus.ja_security.example_06157
use Security
policy no_network

principal WorkerJASEC_06157
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport48 classification restricted
policy PolicyJASEC_06157 {
    deny network.* by default
    allow ModelExport48 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_06157.decision.mcrt"