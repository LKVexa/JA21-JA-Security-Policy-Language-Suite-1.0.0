ja source 0.3
module corpus.ja_security.example_06117
use Security
policy no_network

principal WorkerJASEC_06117
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport8 classification restricted
policy PolicyJASEC_06117 {
    deny network.* by default
    deny ModelExport8 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_06117.decision.mcrt"