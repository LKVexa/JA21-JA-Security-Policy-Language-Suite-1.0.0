ja source 0.3
module corpus.ja_security.example_01452
use Security
policy no_network

principal WorkerJASEC_01452
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport96 classification restricted
policy PolicyJASEC_01452 {
    deny network.* by default
    allow ModelExport96 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01452.decision.mcrt"