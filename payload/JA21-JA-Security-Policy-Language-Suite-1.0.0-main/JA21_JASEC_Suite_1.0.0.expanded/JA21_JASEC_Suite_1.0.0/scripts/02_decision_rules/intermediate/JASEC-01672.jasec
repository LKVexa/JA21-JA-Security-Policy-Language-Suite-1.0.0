ja source 0.3
module corpus.ja_security.example_01672
use Security
policy no_network

principal WorkerJASEC_01672
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport25 classification restricted
policy PolicyJASEC_01672 {
    deny network.* by default
    allow ModelExport25 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01672.decision.mcrt"