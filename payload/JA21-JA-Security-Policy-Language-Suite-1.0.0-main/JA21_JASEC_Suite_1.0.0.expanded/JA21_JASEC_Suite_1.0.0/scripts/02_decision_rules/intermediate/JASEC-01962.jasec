ja source 0.3
module corpus.ja_security.example_01962
use Security
policy no_network

principal WorkerJASEC_01962
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport24 classification restricted
policy PolicyJASEC_01962 {
    deny network.* by default
    allow ModelExport24 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01962.decision.mcrt"