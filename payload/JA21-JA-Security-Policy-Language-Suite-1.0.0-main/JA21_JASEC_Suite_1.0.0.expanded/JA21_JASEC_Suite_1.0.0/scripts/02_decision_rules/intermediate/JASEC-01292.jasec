ja source 0.3
module corpus.ja_security.example_01292
use Security
policy no_network

principal WorkerJASEC_01292
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport33 classification restricted
policy PolicyJASEC_01292 {
    deny network.* by default
    allow ModelExport33 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01292.decision.mcrt"