ja source 0.3
module corpus.ja_security.example_01372
use Security
policy no_network

principal WorkerJASEC_01372
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport16 classification restricted
policy PolicyJASEC_01372 {
    deny network.* by default
    allow ModelExport16 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01372.decision.mcrt"