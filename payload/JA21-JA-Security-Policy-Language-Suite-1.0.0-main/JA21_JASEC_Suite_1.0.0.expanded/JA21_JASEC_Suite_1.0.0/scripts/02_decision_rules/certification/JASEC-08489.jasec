ja source 0.3
module corpus.ja_security.example_08489
use Security
policy no_network

principal WorkerJASEC_08489
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport52 classification restricted
policy PolicyJASEC_08489 {
    deny network.* by default
    allow ModelExport52 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_08489.decision.mcrt"