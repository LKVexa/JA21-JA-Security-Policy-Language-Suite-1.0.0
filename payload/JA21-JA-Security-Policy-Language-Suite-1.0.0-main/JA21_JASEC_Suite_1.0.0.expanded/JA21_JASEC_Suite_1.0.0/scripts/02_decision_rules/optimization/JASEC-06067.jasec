ja source 0.3
module corpus.ja_security.example_06067
use Security
policy no_network

principal WorkerJASEC_06067
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport55 classification restricted
policy PolicyJASEC_06067 {
    deny network.* by default
    allow ModelExport55 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_06067.decision.mcrt"