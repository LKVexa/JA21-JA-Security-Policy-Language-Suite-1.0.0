ja source 0.3
module corpus.ja_security.example_04685
use Security
policy no_network

principal WorkerJASEC_04685
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport31 classification restricted
policy PolicyJASEC_04685 {
    deny network.* by default
    allow ModelExport31 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04685.decision.mcrt"