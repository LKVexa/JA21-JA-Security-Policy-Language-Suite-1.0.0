ja source 0.3
module corpus.ja_security.example_04845
use Security
policy no_network

principal WorkerJASEC_04845
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport94 classification restricted
policy PolicyJASEC_04845 {
    deny network.* by default
    allow ModelExport94 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04845.decision.mcrt"