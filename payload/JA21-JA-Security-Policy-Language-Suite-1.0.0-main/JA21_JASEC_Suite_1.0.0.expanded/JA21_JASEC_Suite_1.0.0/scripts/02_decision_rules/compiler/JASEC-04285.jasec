ja source 0.3
module corpus.ja_security.example_04285
use Security
policy no_network

principal WorkerJASEC_04285
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport19 classification restricted
policy PolicyJASEC_04285 {
    deny network.* by default
    allow ModelExport19 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04285.decision.mcrt"