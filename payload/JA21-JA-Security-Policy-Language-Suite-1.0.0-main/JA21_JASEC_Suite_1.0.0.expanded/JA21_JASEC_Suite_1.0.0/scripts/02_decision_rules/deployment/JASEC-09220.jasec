ja source 0.3
module corpus.ja_security.example_09220
use Security
policy no_network

principal WorkerJASEC_09220
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport7 classification restricted
policy PolicyJASEC_09220 {
    deny network.* by default
    allow ModelExport7 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09220.decision.mcrt"