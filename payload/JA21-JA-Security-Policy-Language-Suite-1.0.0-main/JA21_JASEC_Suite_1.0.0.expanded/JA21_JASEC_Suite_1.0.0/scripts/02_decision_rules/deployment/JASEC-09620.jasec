ja source 0.3
module corpus.ja_security.example_09620
use Security
policy no_network

principal WorkerJASEC_09620
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport19 classification restricted
policy PolicyJASEC_09620 {
    deny network.* by default
    allow ModelExport19 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09620.decision.mcrt"