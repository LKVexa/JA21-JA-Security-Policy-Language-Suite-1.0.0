ja source 0.3
module corpus.ja_security.example_09570
use Security
policy no_network

principal WorkerJASEC_09570
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport66 classification restricted
policy PolicyJASEC_09570 {
    deny network.* by default
    allow ModelExport66 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09570.decision.mcrt"