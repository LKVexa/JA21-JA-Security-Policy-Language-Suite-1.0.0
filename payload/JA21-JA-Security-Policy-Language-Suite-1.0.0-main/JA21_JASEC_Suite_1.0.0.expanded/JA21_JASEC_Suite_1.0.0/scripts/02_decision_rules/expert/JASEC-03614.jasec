ja source 0.3
module corpus.ja_security.example_03614
use Security
policy no_network

principal WorkerJASEC_03614
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport27 classification restricted
policy PolicyJASEC_03614 {
    deny network.* by default
    allow ModelExport27 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03614.decision.mcrt"