ja source 0.3
module corpus.ja_security.example_05496
use Security
policy no_network

principal WorkerJASEC_05496
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport66 classification restricted
policy PolicyJASEC_05496 {
    deny network.* by default
    allow ModelExport66 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_05496.decision.mcrt"