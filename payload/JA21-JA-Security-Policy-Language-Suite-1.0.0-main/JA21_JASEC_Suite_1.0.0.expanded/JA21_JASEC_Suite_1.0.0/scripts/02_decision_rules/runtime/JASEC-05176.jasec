ja source 0.3
module corpus.ja_security.example_05176
use Security
policy no_network

principal WorkerJASEC_05176
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport37 classification restricted
policy PolicyJASEC_05176 {
    deny network.* by default
    allow ModelExport37 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05176.decision.mcrt"