ja source 0.3
module corpus.ja_security.example_05336
use Security
policy no_network

principal WorkerJASEC_05336
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport3 classification restricted
policy PolicyJASEC_05336 {
    deny network.* by default
    allow ModelExport3 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05336.decision.mcrt"