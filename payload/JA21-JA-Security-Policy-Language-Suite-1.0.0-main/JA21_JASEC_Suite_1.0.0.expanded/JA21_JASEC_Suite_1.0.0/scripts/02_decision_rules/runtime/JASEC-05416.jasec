ja source 0.3
module corpus.ja_security.example_05416
use Security
policy no_network

principal WorkerJASEC_05416
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport83 classification restricted
policy PolicyJASEC_05416 {
    deny network.* by default
    allow ModelExport83 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_05416.decision.mcrt"