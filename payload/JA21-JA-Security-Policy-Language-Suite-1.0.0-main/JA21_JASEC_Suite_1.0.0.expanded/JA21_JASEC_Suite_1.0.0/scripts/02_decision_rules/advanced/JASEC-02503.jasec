ja source 0.3
module corpus.ja_security.example_02503
use Security
policy no_network

principal WorkerJASEC_02503
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport80 classification restricted
policy PolicyJASEC_02503 {
    deny network.* by default
    allow ModelExport80 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_02503.decision.mcrt"