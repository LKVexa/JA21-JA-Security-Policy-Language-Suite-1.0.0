ja source 0.3
module corpus.ja_security.example_02093
use Security
policy no_network

principal WorkerJASEC_02093
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport58 classification restricted
policy PolicyJASEC_02093 {
    deny network.* by default
    allow ModelExport58 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_02093.decision.mcrt"