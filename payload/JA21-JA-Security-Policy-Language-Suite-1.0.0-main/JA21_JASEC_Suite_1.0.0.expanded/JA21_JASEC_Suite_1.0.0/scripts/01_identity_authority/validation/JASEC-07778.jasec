ja source 0.3
module corpus.ja_security.example_07778
use Security
policy no_network

principal WorkerJASEC_07778
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport20 classification restricted
policy PolicyJASEC_07778 {
    deny network.* by default
    allow ModelExport20 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_07778.decision.mcrt"