ja source 0.3
module corpus.ja_security.example_03464
use Security
policy no_network

principal WorkerJASEC_03464
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport71 classification restricted
policy PolicyJASEC_03464 {
    deny network.* by default
    allow ModelExport71 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_03464.decision.mcrt"