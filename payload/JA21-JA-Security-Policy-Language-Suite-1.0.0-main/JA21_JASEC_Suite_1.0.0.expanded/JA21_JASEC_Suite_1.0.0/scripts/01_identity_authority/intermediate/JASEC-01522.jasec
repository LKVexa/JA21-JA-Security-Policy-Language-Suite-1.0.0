ja source 0.3
module corpus.ja_security.example_01522
use Security
policy no_network

principal WorkerJASEC_01522
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport69 classification restricted
policy PolicyJASEC_01522 {
    deny network.* by default
    allow ModelExport69 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01522.decision.mcrt"