ja source 0.3
module corpus.ja_security.example_06457
use Security
policy no_network

principal WorkerJASEC_06457
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport57 classification restricted
policy PolicyJASEC_06457 {
    deny network.* by default
    allow ModelExport57 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06457.decision.mcrt"