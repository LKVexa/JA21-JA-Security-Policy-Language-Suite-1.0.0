ja source 0.3
module corpus.ja_security.example_06777
use Security
policy no_network

principal WorkerJASEC_06777
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport86 classification restricted
policy PolicyJASEC_06777 {
    deny network.* by default
    allow ModelExport86 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06777.decision.mcrt"