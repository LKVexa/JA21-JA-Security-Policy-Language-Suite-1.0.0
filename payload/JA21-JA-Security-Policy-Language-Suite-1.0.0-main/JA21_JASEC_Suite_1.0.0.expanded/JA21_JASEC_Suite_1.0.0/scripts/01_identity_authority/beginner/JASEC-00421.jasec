ja source 0.3
module corpus.ja_security.example_00421
use Security
policy no_network

principal WorkerJASEC_00421
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport35 classification restricted
policy PolicyJASEC_00421 {
    deny network.* by default
    allow ModelExport35 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_00421.decision.mcrt"