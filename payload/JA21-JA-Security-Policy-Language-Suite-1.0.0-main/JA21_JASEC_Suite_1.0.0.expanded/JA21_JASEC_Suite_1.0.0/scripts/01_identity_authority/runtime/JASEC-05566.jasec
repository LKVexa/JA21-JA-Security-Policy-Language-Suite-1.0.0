ja source 0.3
module corpus.ja_security.example_05566
use Security
policy no_network

principal WorkerJASEC_05566
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport39 classification restricted
policy PolicyJASEC_05566 {
    deny network.* by default
    allow ModelExport39 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05566.decision.mcrt"