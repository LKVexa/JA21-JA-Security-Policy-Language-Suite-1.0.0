ja source 0.3
module corpus.ja_security.example_04675
use Security
policy no_network

principal WorkerJASEC_04675
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport21 classification restricted
policy PolicyJASEC_04675 {
    deny network.* by default
    allow ModelExport21 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04675.decision.mcrt"