ja source 0.3
module corpus.ja_security.example_04835
use Security
policy no_network

principal WorkerJASEC_04835
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport84 classification restricted
policy PolicyJASEC_04835 {
    deny network.* by default
    allow ModelExport84 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_04835.decision.mcrt"