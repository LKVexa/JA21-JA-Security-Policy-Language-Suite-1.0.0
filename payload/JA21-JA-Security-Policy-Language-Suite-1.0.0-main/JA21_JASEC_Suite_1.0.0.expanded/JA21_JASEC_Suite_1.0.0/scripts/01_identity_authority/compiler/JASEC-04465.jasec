ja source 0.3
module corpus.ja_security.example_04465
use Security
policy no_network

principal WorkerJASEC_04465
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport5 classification restricted
policy PolicyJASEC_04465 {
    deny network.* by default
    allow ModelExport5 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_04465.decision.mcrt"