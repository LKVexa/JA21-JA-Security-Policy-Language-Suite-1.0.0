ja source 0.3
module corpus.ja_security.example_00511
use Security
policy no_network

principal WorkerJASEC_00511
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport28 classification restricted
policy PolicyJASEC_00511 {
    deny network.* by default
    allow ModelExport28 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_00511.decision.mcrt"