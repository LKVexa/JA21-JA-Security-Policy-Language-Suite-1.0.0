ja source 0.3
module corpus.ja_security.example_09970
use Security
policy no_network

principal WorkerJASEC_09970
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport78 classification restricted
policy PolicyJASEC_09970 {
    deny network.* by default
    allow ModelExport78 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_09970.decision.mcrt"