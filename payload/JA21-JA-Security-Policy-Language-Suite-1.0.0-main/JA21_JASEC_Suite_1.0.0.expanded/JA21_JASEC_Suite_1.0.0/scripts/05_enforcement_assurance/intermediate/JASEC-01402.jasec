ja source 0.3
module corpus.ja_security.example_01402
use Security
policy no_network

principal WorkerJASEC_01402
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport46 classification restricted
policy PolicyJASEC_01402 {
    deny network.* by default
    allow ModelExport46 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01402.decision.mcrt"