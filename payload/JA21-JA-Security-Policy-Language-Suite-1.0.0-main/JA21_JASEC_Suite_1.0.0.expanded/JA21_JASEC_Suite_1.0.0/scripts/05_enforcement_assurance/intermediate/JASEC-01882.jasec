ja source 0.3
module corpus.ja_security.example_01882
use Security
policy no_network

principal WorkerJASEC_01882
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport41 classification restricted
policy PolicyJASEC_01882 {
    deny network.* by default
    allow ModelExport41 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01882.decision.mcrt"