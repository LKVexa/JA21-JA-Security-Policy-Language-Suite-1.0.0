ja source 0.3
module corpus.ja_security.example_05296
use Security
policy no_network

principal WorkerJASEC_05296
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport60 classification restricted
policy PolicyJASEC_05296 {
    deny network.* by default
    allow ModelExport60 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05296.decision.mcrt"