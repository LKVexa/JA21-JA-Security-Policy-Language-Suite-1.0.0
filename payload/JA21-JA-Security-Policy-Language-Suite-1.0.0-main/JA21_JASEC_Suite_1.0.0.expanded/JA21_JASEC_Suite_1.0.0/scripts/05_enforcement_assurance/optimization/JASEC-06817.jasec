ja source 0.3
module corpus.ja_security.example_06817
use Security
policy no_network

principal WorkerJASEC_06817
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport29 classification restricted
policy PolicyJASEC_06817 {
    deny network.* by default
    allow ModelExport29 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06817.decision.mcrt"