ja source 0.3
module corpus.ja_security.example_02453
use Security
policy no_network

principal WorkerJASEC_02453
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport30 classification restricted
policy PolicyJASEC_02453 {
    deny network.* by default
    allow ModelExport30 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_02453.decision.mcrt"