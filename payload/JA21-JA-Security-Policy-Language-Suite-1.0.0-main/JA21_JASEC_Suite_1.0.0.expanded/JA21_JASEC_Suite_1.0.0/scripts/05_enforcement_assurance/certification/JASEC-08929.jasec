ja source 0.3
module corpus.ja_security.example_08929
use Security
policy no_network

principal WorkerJASEC_08929
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport7 classification restricted
policy PolicyJASEC_08929 {
    deny network.* by default
    allow ModelExport7 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_08929.decision.mcrt"