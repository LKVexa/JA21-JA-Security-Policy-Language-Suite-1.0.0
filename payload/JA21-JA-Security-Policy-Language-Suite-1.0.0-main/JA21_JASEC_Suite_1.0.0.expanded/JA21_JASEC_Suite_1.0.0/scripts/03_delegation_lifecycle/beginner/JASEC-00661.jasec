ja source 0.3
module corpus.ja_security.example_00661
use Security
policy no_network

principal WorkerJASEC_00661
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport81 classification restricted
policy PolicyJASEC_00661 {
    deny network.* by default
    allow ModelExport81 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_00661.decision.mcrt"