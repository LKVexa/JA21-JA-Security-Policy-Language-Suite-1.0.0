ja source 0.3
module corpus.ja_security.example_00551
use Security
policy no_network

principal WorkerJASEC_00551
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport68 classification restricted
policy PolicyJASEC_00551 {
    deny network.* by default
    allow ModelExport68 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_00551.decision.mcrt"