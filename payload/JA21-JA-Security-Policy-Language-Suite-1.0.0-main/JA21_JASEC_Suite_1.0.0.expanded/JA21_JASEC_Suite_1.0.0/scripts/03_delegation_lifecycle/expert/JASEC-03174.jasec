ja source 0.3
module corpus.ja_security.example_03174
use Security
policy no_network

principal WorkerJASEC_03174
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport72 classification restricted
policy PolicyJASEC_03174 {
    deny network.* by default
    allow ModelExport72 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03174.decision.mcrt"