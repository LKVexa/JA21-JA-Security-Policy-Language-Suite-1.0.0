ja source 0.3
module corpus.ja_security.example_03084
use Security
policy no_network

principal WorkerJASEC_03084
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport79 classification restricted
policy PolicyJASEC_03084 {
    deny network.* by default
    allow ModelExport79 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03084.decision.mcrt"