ja source 0.3
module corpus.ja_security.example_03534
use Security
policy no_network

principal WorkerJASEC_03534
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport44 classification restricted
policy PolicyJASEC_03534 {
    deny network.* by default
    allow ModelExport44 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_03534.decision.mcrt"