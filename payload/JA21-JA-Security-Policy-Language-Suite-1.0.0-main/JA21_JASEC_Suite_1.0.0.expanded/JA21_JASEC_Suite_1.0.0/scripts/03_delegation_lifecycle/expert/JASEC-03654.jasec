ja source 0.3
module corpus.ja_security.example_03654
use Security
policy no_network

principal WorkerJASEC_03654
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport67 classification restricted
policy PolicyJASEC_03654 {
    deny network.* by default
    allow ModelExport67 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03654.decision.mcrt"