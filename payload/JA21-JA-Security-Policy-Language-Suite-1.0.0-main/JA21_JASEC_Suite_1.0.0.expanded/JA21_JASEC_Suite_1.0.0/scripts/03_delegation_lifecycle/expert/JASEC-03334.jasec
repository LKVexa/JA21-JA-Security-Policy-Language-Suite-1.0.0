ja source 0.3
module corpus.ja_security.example_03334
use Security
policy no_network

principal WorkerJASEC_03334
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport38 classification restricted
policy PolicyJASEC_03334 {
    deny network.* by default
    allow ModelExport38 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_03334.decision.mcrt"