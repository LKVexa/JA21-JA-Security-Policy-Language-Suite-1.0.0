ja source 0.3
module corpus.ja_security.example_08499
use Security
policy no_network

principal WorkerJASEC_08499
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport62 classification restricted
policy PolicyJASEC_08499 {
    deny network.* by default
    allow ModelExport62 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_08499.decision.mcrt"