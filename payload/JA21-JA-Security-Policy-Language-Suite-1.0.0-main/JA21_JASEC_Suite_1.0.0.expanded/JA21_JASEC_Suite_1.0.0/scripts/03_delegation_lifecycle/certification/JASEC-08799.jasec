ja source 0.3
module corpus.ja_security.example_08799
use Security
policy no_network

principal WorkerJASEC_08799
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport71 classification restricted
policy PolicyJASEC_08799 {
    deny network.* by default
    allow ModelExport71 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_08799.decision.mcrt"