ja source 0.3
module corpus.ja_security.example_02483
use Security
policy no_network

principal WorkerJASEC_02483
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport60 classification restricted
policy PolicyJASEC_02483 {
    deny network.* by default
    allow ModelExport60 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_02483.decision.mcrt"