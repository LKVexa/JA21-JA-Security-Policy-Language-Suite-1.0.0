ja source 0.3
module corpus.ja_security.example_02653
use Security
policy no_network

principal WorkerJASEC_02653
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport36 classification restricted
policy PolicyJASEC_02653 {
    deny network.* by default
    allow ModelExport36 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_02653.decision.mcrt"