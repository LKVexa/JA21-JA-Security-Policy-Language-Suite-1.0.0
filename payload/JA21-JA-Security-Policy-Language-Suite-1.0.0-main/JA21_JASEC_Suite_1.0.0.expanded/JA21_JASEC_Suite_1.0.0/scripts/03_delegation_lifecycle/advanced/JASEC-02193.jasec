ja source 0.3
module corpus.ja_security.example_02193
use Security
policy no_network

principal WorkerJASEC_02193
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport61 classification restricted
policy PolicyJASEC_02193 {
    deny network.* by default
    allow ModelExport61 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_02193.decision.mcrt"