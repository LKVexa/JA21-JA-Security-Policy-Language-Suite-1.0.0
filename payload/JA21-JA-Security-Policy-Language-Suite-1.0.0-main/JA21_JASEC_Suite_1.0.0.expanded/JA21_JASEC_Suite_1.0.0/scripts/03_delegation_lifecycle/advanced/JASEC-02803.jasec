ja source 0.3
module corpus.ja_security.example_02803
use Security
policy no_network

principal WorkerJASEC_02803
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport89 classification restricted
policy PolicyJASEC_02803 {
    deny network.* by default
    allow ModelExport89 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_02803.decision.mcrt"