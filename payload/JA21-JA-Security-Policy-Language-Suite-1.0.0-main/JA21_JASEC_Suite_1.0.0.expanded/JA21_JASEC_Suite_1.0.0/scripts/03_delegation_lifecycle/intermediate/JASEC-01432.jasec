ja source 0.3
module corpus.ja_security.example_01432
use Security
policy no_network

principal WorkerJASEC_01432
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport76 classification restricted
policy PolicyJASEC_01432 {
    deny network.* by default
    allow ModelExport76 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_01432.decision.mcrt"