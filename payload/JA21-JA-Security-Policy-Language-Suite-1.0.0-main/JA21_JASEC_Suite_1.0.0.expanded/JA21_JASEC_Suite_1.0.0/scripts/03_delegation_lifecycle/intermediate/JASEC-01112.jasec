ja source 0.3
module corpus.ja_security.example_01112
use Security
policy no_network

principal WorkerJASEC_01112
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport47 classification restricted
policy PolicyJASEC_01112 {
    deny network.* by default
    allow ModelExport47 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01112.decision.mcrt"