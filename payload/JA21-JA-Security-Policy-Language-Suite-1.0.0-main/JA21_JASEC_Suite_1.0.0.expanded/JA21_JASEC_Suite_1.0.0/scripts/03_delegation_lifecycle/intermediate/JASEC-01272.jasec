ja source 0.3
module corpus.ja_security.example_01272
use Security
policy no_network

principal WorkerJASEC_01272
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport13 classification restricted
policy PolicyJASEC_01272 {
    deny network.* by default
    allow ModelExport13 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01272.decision.mcrt"