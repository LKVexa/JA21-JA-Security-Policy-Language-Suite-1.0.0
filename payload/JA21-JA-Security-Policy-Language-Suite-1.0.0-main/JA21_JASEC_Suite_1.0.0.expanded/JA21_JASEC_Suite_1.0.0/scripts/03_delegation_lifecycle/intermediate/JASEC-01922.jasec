ja source 0.3
module corpus.ja_security.example_01922
use Security
policy no_network

principal WorkerJASEC_01922
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport81 classification restricted
policy PolicyJASEC_01922 {
    deny network.* by default
    allow ModelExport81 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_01922.decision.mcrt"