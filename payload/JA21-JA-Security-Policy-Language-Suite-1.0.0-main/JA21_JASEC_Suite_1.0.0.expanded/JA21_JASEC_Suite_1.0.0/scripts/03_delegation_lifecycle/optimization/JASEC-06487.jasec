ja source 0.3
module corpus.ja_security.example_06487
use Security
policy no_network

principal WorkerJASEC_06487
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport87 classification restricted
policy PolicyJASEC_06487 {
    deny network.* by default
    allow ModelExport87 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06487.decision.mcrt"