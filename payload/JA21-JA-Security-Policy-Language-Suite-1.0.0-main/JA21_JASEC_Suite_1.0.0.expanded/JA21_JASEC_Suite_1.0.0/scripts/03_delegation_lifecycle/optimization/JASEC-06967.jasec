ja source 0.3
module corpus.ja_security.example_06967
use Security
policy no_network

principal WorkerJASEC_06967
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport82 classification restricted
policy PolicyJASEC_06967 {
    deny network.* by default
    allow ModelExport82 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06967.decision.mcrt"