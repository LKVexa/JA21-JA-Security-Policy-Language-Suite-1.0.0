ja source 0.3
module corpus.ja_security.example_06687
use Security
policy no_network

principal WorkerJASEC_06687
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport93 classification restricted
policy PolicyJASEC_06687 {
    deny network.* by default
    allow ModelExport93 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_06687.decision.mcrt"