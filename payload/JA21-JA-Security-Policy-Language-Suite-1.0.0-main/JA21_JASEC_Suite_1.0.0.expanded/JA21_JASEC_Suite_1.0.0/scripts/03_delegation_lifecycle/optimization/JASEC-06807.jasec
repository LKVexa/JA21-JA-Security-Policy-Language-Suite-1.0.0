ja source 0.3
module corpus.ja_security.example_06807
use Security
policy no_network

principal WorkerJASEC_06807
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport19 classification restricted
policy PolicyJASEC_06807 {
    deny network.* by default
    allow ModelExport19 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_06807.decision.mcrt"