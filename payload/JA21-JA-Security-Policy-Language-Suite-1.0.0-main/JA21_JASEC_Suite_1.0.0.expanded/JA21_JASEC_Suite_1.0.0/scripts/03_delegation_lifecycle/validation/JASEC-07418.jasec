ja source 0.3
module corpus.ja_security.example_07418
use Security
policy no_network

principal WorkerJASEC_07418
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport48 classification restricted
policy PolicyJASEC_07418 {
    deny network.* by default
    allow ModelExport48 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_07418.decision.mcrt"