ja source 0.3
module corpus.ja_security.example_05666
use Security
policy no_network

principal WorkerJASEC_05666
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport42 classification restricted
policy PolicyJASEC_05666 {
    deny network.* by default
    allow ModelExport42 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_05666.decision.mcrt"