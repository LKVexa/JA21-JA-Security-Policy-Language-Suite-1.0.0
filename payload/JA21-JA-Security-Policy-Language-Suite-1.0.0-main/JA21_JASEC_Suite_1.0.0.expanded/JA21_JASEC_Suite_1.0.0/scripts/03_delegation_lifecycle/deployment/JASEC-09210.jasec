ja source 0.3
module corpus.ja_security.example_09210
use Security
policy no_network

principal WorkerJASEC_09210
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport94 classification restricted
policy PolicyJASEC_09210 {
    deny network.* by default
    allow ModelExport94 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == false
emit mcrt "PolicyJASEC_09210.decision.mcrt"