ja source 0.3
module corpus.ja_security.example_09550
use Security
policy no_network

principal WorkerJASEC_09550
role TrainingWorker {
    grant device.gpu
    grant dataset.read:approved
}
resource ModelExport46 classification restricted
policy PolicyJASEC_09550 {
    deny network.* by default
    allow ModelExport46 when principal.role == TrainingWorker
    require human_approval for model.export
    audit all privileged_effects
    redact secret.values
    resolve conflicts explicit_deny_wins
}
assert policy.secret_leak == true
emit mcrt "PolicyJASEC_09550.decision.mcrt"